[Unit]
Description=Liao case collection (root, read-only on host)
Documentation=file:/opt/liao/collect_case.sh
ConditionPathIsDirectory=/var/lib/liao/cases
OnSuccess=liao-assemble.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/liao/collect_case.sh
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=idle
UMask=0077
ProtectSystem=strict
ReadWritePaths=/var/lib/liao/cases
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
